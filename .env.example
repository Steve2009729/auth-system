# ─────────────────────────────────────────────────────────────
#  AuthSystem — Environment Variables
#  Copy this file to .env and edit as needed.
#
#  For a local dev run you only need to change SECRET_KEY.
#  SMTP and OAuth sections are optional — the app boots without
#  them (email and OAuth features are gracefully disabled).
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME=AuthSystem
# Set DEBUG=true for local development (enables auto-reload, verbose logs)
DEBUG=true
# PORT is dynamically assigned on Render; defaults to 8000 locally
PORT=8000

# Generate a secure key:  python -c "import secrets; print(secrets.token_hex(64))"
# Or run: authsystem init  — it writes one for you automatically.
# Leave blank in dev and a temporary key is auto-generated with a warning.
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────
# Default matches the docker-compose.yml db service — no changes needed for local dev.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/authdb

# ── Redis ────────────────────────────────────────────────────
# Default matches the docker-compose.yml redis service.
REDIS_URL=redis://localhost:6379/0

# ── Email / SMTP (optional) ──────────────────────────────────
# If left as placeholders, email sending is silently skipped.
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM=noreply@authsystem.com

# ── Frontend URL (used in email links) ───────────────────────
FRONTEND_URL=http://localhost:3000

# ── OAuth — Google (optional) ────────────────────────────────
# Leave as placeholders to disable Google login (routes return 501).
# Set up at: https://console.developers.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── OAuth — GitHub (optional) ────────────────────────────────
# Leave as placeholders to disable GitHub login (routes return 501).
# Set up at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
